# Ссылка на доску Asana (Board view)
ASANA_PROJECT_URL=https://app.asana.com/0/<project-id>/board

# CRM API. Для локального запуска: npm run mock:crm
CRM_API_URL=http://127.0.0.1:4010
CRM_API_KEY=test-key

# Необязательно: второй источник бренд/гео (по умолчанию data/lookup.json)
# LOOKUP_FILE=data/lookup.example.json
