{
  "name": "asana-board-automation",
  "version": "1.0.0",
  "description": "UI automation of Asana boards with Playwright: creates tasks from templates, validates data via a REST API before the run",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "tasks": "node index.js --list",
    "auth": "node auth.js",
    "format": "node src/formatOnly.js",
    "mock:crm": "node mock/crmMockServer.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "engines": { "node": ">=20" },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "playwright": "^1.58.2"
  }
}
